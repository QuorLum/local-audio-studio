{
    "model_type": "diffusion_cond_inpaint",
    "sample_size": 5292032,
    "sample_rate": 44100,
    "audio_channels": 2,
    "model": {
        "pretransform": {
            "type": "autoencoder",
            "iterate_batch": false,
